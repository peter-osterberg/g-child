	// Gc templates
	// Js
	"JavaScript class template": {
		"scope": "javascript",
		"prefix": "gcJsClassTemplate",
		"body": [
			"/**",
			" * $1 - A class for handling functionality",
			" */",
			"class $1 {",
			"\t/**",
			"\t * Setup method",
			"\t * Static method to set up the class on the page",
			"\t *",
			"\t * @return {void}",
			"\t */",
			"\tstatic setup() {",
			"\t\tconst elements = document.querySelectorAll('${2:class/tag/id}');",
			"",
			"\t\tfor (const element of elements) {",
			"\t\t\tconst instance = new $1(element);",
			"\t\t\tinstance.init();",
			"\t\t}",
			"\t}",
			"",
			"\t/**",
			"\t * Constructor method",
			"\t *",
			"\t * @param {HTMLElement} element",
			"\t * @return {void}",
			"\t */",
			"\tconstructor(element) {",
			"\t\tthis.element = element;",
			"\t\t$3",
			"\t}",
			"",
			"\t/**",
			"\t * Initialize method",
			"\t * Method to initialize a class instance",
			"\t */",
			"\tinit() {",
			"\t\tthis.addEventListeners();",
			"\t}",
			"",
			"\t/**",
			"\t * Add event listeners",
			"\t *",
			"\t * @return {void}",
			"\t */",
			"\taddEventListeners() {",
			"\t\t// this.element.addEventListener('click', this.methodName.bind(this));",
			"\t}",
			"",
			"\t/**",
			"\t * Method name",
			"\t *",
			"\t * @return {void}",
			"\t */",
			"\tmethodName() {",
			"\t\t// do something",
			"\t}",
			"}",
			"",
			"// The document is checked if it is ready. If it is, the setup() method is called.",
			"if (document.readyState === 'interactive' || document.readyState === 'complete') {",
			"\t$1.setup();",
			"} else {",
			"\tdocument.addEventListener('DOMContentLoaded', $1.setup);",
			"}",
		],
		"description": "JavaScript class template",
	},

