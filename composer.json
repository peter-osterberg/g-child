{
	"name": "thegeneration/generation-theme-child",
	"description": "Child theme for G-Theme",
	"type": "wordpress-theme",
	"require-dev": {
		"squizlabs/php_codesniffer": "^3.7",
		"wp-coding-standards/wpcs": "dev-develop",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"symfony/console": "^6.0"
	},
	"autoload": {
		"psr-4": {
			"GTheme_Child\\": "inc"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"GChild_Console\\": "console"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"install-po-merge-driver": [
			"chmod +x bin/install-po-merge-driver.sh",
			"[ \"${COMPOSER_DEV_MODE:-1}\" -eq 0 ] || ./bin/install-po-merge-driver.sh"
		],
		"post-install-cmd": [
			"@install-po-merge-driver"
		],
		"post-update-cmd": [
			"@install-po-merge-driver"
		]
	}
}
